{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for DA_Page",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --detectOpenHandles --forceExit",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/templates/",
      "/public/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true,
    "forceExit": true,
    "clearMocks": true,
    "resetMocks": true,
    "restoreMocks": true,
    "setupFilesAfterEnv": ["./jest.setup.js"]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^6.0.12",
    "nodemailer": "^7.0.6",
    "transbank-sdk": "^6.1.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.7",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "mongodb-memory-server": "^9.1.6",
    "@babel/preset-env": "^7.23.9",
    "babel-jest": "^29.7.0"
  },
  "author": "",
  "license": "ISC"
}
